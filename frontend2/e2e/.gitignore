# Generated by e2e/global-setup.ts: one storageState file per role, each
# holding a live Django session key. Regenerated on every run, and a session
# key belongs in a repository no more than a password does.
.auth/

# Traces, failure screenshots and the HTML report. Pointed here by
# `outputDir` in playwright.config.ts rather than left at Playwright's
# defaults, because frontend2/test-results is not ignored anywhere — the
# root .gitignore anchors /test-results to the repository root.
.artifacts/
