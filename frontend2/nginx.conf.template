# One origin for the browser: the SPA, and /api and /media proxied to Django.
#
# ${PORT} and ${API_ORIGIN} are filled in at container start by nginx's own
# envsubst entrypoint, so the same image runs against staging or production
# without a rebuild.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Cloud Run terminates TLS in front of us, so the client's real scheme and
    # address arrive in headers. Django needs them for CSRF and for the
    # login-throttle key, which is per-address — without this every request
    # looks like it came from the load balancer and one person locking
    # themselves out would lock out everybody.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass ${API_ORIGIN};
        proxy_http_version 1.1;
        # Uploads are capped at 10MB server-side; nginx defaults to 1MB and
        # would refuse a legitimate paper before Django ever saw it.
        client_max_body_size 12m;
        # A Scopus lookup can take a while, and the default 60s read timeout
        # turns a slow upstream into a 504 the claimant reads as a broken form.
        proxy_read_timeout 120s;
    }

    location /media/ {
        proxy_pass ${API_ORIGIN};
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }

    # Hashed assets never change under their name, so they can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Everything else is the SPA. index.html itself must never be cached, or a
    # deploy leaves browsers loading an old document that references asset
    # filenames the new build no longer has — a blank page that a hard refresh
    # fixes and nothing else does.
    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}
