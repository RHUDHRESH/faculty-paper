# Backend host (Fly / Cloud Run / etc — not Neon)
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.fly.dev,.onrender.com,localhost
# Neon Postgres (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
CROSS_SITE_COOKIES=true
SECURE_SSL_REDIRECT=true
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-APP.vercel.app
SCOPUS_API_KEY=

# Frontend (Vercel) — set in Vercel dashboard
# VITE_API_BASE=https://YOUR-API-HOST
