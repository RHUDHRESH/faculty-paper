{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://faculty-paper-api.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://faculty-paper-api.onrender.com/media/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
