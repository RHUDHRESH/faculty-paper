# Backend (Cloud Run) — set as service env vars / secrets, not in the image
DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=.run.app,localhost
# Neon Postgres (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Private Cloud Storage bucket for uploaded proof PDFs. Without it, uploads
# live on the container filesystem and are lost on the next deploy.
GS_BUCKET_NAME=
# The SPA origin. Needed because the Vercel proxy forwards its Origin header.
CSRF_TRUSTED_ORIGINS=https://YOUR-APP.vercel.app
SECURE_SSL_REDIRECT=true
SCOPUS_API_KEY=

# Frontend: leave VITE_API_BASE unset — vercel.json rewrites /api and /media
# to Cloud Run, keeping the SPA and API same-origin.
